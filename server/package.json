{
  "name": "unknown-king-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server for The Unknown King (الملك المجهول)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "simulate": "tsx src/simulation/run-simulation.ts",
    "build:browser-demo": "node scripts/build-browser-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.15",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
